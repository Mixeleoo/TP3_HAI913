<?xml version="1.0" encoding="UTF-8"?>
<!--
  HAI913I — CM 04 — démonstration « boutique », service dorsal.

  Volontairement petit, mais correctement stratifié : c'est l'architecture
  qui rend lisible la différence entre observabilité TECHNIQUE (les bords,
  que l'agent voit seul) et observabilité MÉTIER (que personne ne devine).

  Le parent spring-boot-starter-parent fixe la version de toutes les
  dépendances qu'il connaît : on n'écrit donc aucune version ici, sauf pour
  OpenTelemetry, qu'il ne connaît pas.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>fr.umontpellier.hai913i</groupId>
  <artifactId>boutique-backend</artifactId>
  <version>1.0.0</version>
  <name>Boutique — service dorsal (observabilité)</name>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Les versions OpenTelemetry sont relevées dans le README. -->
    <otel.version>1.66.0</otel.version>
    <otel.instrumentation.version>2.32.0</otel.instrumentation.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Aligne toutes les bibliothèques OpenTelemetry sur une même version.
        Sans ce BOM, opentelemetry-context arrive en retard de plusieurs
        versions par la porte des annotations.
      -->
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${otel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spring Web MVC. Depuis Spring Boot 4, le démarreur s'appelle -webmvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- Contraintes de validation sur les demandes entrantes. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Hibernate et Spring Data JPA. Ils ne servent pas à faire joli :
      l'agent OpenTelemetry instrumente le pilote JDBC, et la trace montre
      donc une requête SQL que PERSONNE n'a instrumentée à la main. C'est la
      démonstration la plus nette de ce qu'apporte l'instrumentation
      zéro-code sur une bibliothèque qu'on n'a pas écrite.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      API OpenTelemetry : nécessaire à l'instrumentation MANUELLE seulement.
      L'instrumentation zéro-code, elle, ne demande aucune dépendance : c'est
      l'agent qui l'apporte. Sans agent, ces appels deviennent des no-op et
      le service fonctionne à l'identique.
    -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-instrumentation-annotations</artifactId>
      <version>${otel.instrumentation.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>boutique-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
